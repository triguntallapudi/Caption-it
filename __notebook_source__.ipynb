import os
import json
import tensorflow as tf
from tensorflow.keras.models import Model
from tensorflow.keras.layers import Input, Dense, LSTM, Embedding, Dropout, concatenate

# ... (Keep your Tokenizer and Feature Extractor export code from before) ...

# ==========================================
# 3. THE FIX: Unrolled LSTM Conversion
# ==========================================
print("\n3. Converting Caption Decoder to TFLite (Unrolled Mode)...")

# Rebuild the exact same architecture we trained
inputs1_new = Input(shape=(4096,))
fe1_new = Dropout(0.4)(inputs1_new)
fe2_new = Dense(256, activation='relu')(fe1_new)

inputs2_new = Input(shape=(max_length,))
se1_new = Embedding(vocab_size, 256)(inputs2_new) 
se2_new = Dropout(0.4)(se1_new)

# THE OVERRIDE: unroll=True forces a completely standard, hardware-agnostic graph
se3_new = LSTM(256, unroll=True)(se2_new) 

decoder1_new = concatenate([fe2_new, se3_new])
decoder2_new = Dense(256, activation='relu')(decoder1_new)
outputs_new = Dense(vocab_size, activation='softmax')(decoder2_new)

# Create the new shell model
tflite_model_shell = Model(inputs=[inputs1_new, inputs2_new], outputs=outputs_new)

# Transfer the knowledge from your trained model to this mobile-friendly shell
tflite_model_shell.set_weights(model.get_weights())

# Convert the unrolled model
converter = tf.lite.TFLiteConverter.from_keras_model(tflite_model_shell)
converter.target_spec.supported_ops = [
    tf.lite.OpsSet.TFLITE_BUILTINS, 
    tf.lite.OpsSet.SELECT_TF_OPS    
]

tflite_caption_model = converter.convert()
with open('lstm_caption_model.tflite', 'wb') as f:
    f.write(tflite_caption_model)

print("\n🎉 Caption Model saved as 'lstm_caption_model.tflite'!")


